class Solution {
    public int numberOfMatches(int n) {
        int matches = 0;
        int team = 0;
        int count = 0;
        while(n>1){
            if(n%2==0){
                matches = n/2;
                team = n/2;
            }else{
                matches = (n-1)/2;
                team = (n-1)/2+1;
            }
            count = count+matches;
            n = team;

        }
        return count;
    }
}
