class Solution {
    public boolean isPalindrome(int x) {
        int r;
        int temp=x;
        int s=0;
        if(x==0){
            return true;
        }
       if(x>0){
         while(x>0){
            r = x%10;
            s=s*10+r;
            x=x/10;
            }
            return s==temp;
        }else{
            return false;
        }
    }
}
