class Solution {
    public int findContentChildren(int[] g, int[] s) {
        int gs = g.length;
        int ss = s.length;
        int count=0;
        Arrays.sort(g);
        Arrays.sort(s);
        int i =0;
        int j =0;
        while(i<ss && j<gs){
            if(s[i]>=g[j]){
                count++;
                j++;
            }
            i++;
        }
        return count;
    }
}
