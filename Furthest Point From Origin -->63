class Solution {
    public int furthestDistanceFromOrigin(String moves) {
        int c1 = 0;
        int c2 = 0;
        int c3 = 0;
        char c[] = moves.toCharArray();
        for(char ch : c){
            if(ch=='L'){
                c1++;
            }else if(ch=='_'){
                c2++;
            }else{
                c3++;
            }
        }
        return Math.abs(c3-c1)+c2;
    }
}
