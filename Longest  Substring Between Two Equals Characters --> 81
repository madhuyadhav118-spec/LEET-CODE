class Solution {
    public int maxLengthBetweenEqualCharacters(String s) {
        // Map stores: Key = Character, Value = First index it appeared at
        HashMap<Character, Integer> map = new HashMap<>();
        int max = -1; // Default to -1 as per problem requirements

        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            
            if (map.containsKey(c)) {
                // If we've seen it before, calculate the gap
                int gap = i - map.get(c) - 1;
                max = Math.max(max, gap);
            } else {
                // If it's the first time, store the index
                map.put(c, i);
            }
        }
        
        return max;
    }
}
