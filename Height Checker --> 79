class Solution {
    public int heightChecker(int[] heights) {
        int n = heights.length;
        int b[] = new int[n];
        for(int i=0; i< n;i++){
            b[i]=heights[i];
        }
        int count = 0;
        Arrays.sort(heights);
        for(int i=0; i<n;i++){
            if(b[i]!=heights[i]){
                count++;
            }
        }
        return count;
    }
}
