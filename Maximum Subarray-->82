class Solution {
    public int maxSubArray(int[] nums) {
        int n = nums.length;
        int sum = 0;
        int maxSum =Integer.MIN_VALUE;
        int curSum =0;
        for(int i=0;i<n;i++){
            if(curSum<0){
                curSum =0;
            }
            curSum = curSum+nums[i];
            //curSum = Math.max(curSum,sum);
             maxSum = Math.max(maxSum,curSum);
        }
        return maxSum;
    }
}
