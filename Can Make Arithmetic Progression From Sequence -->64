class Solution {
    public boolean canMakeArithmeticProgression(int[] arr) {
        Arrays.sort(arr);
        boolean found = true;
        for(int i =1; i<arr.length-1;i++){
            if(Math.abs(arr[i-1]-arr[i]) == Math.abs(arr[i]-arr[i+1])){
                found = true;
            }else{
                found = false;
                break;
            }
        }
        return found;
    }
}
