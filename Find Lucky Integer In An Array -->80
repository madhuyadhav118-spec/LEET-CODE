class Solution {
    public int findLucky(int[] arr) {
        HashMap<Integer, Integer> map = new HashMap<>();
        for(int num : arr){
            map.put(num,map.getOrDefault(num,0)+1);
        }
       
        int a[] = new int[arr.length];
        int idx =0;
        for(int i =0;i<arr.length;i++){
            if(arr[i]==map.get(arr[i])){
                a[idx++]=arr[i];
            }    
        }
        int max=a[0];
        for(int x:a){
            max=Math.max(x,max);
        }
        if(max==0){
            return -1;
        }else{
            return max;
        }
        
    }
}
