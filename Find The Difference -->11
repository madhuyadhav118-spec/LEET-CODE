class Solution {
    public char findTheDifference(String s, String t) {
        int res = 0;
        char c1[] = s.toCharArray();
        char c2[] = t.toCharArray();
        for(char ch :c1){
            res = res^ch;
        }
        for(char ch:c2){
            res = res^ch;
        }
        return (char)res;
    }
}
